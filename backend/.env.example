# Copy to backend/.env for local development. Never commit the real file.
# Local Docker PostgreSQL development connection. Replace only for your own local setup.
DATABASE_URL=postgresql://zamy_dev_user:zamy_dev_password_change_me@localhost:5432/zamy_dev?schema=public
PORT=3000
JWT_SECRET=replace-with-a-32-byte-random-secret
INTERNAL_JOB_SECRET=replace-with-a-unique-long-internal-job-secret
# Used only by the manual `npm run admin:bootstrap` command; never at application startup.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
VNPAY_TMN_CODE=replace-with-value-from-vnpay-merchant-portal
VNPAY_HASH_SECRET=replace-with-rotated-value-from-vnpay-merchant-portal
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/orders/vnpay-return
FRONTEND_URL=http://localhost:4200
# Comma-separated browser origins allowed in production, for example:
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
CORS_ORIGINS=http://localhost:4200
